# =============================================================================
# Laboratorio SOC - variaveis do docker compose
# Copie para .env (copy .env.example .env) e ajuste. O .env NAO vai para o git.
# =============================================================================
COMPOSE_PROJECT_NAME=lab-soc

# ---- Versoes ---------------------------------------------------------------
WAZUH_VERSION=4.14.10
SURICATA_IMAGE=jasonish/suricata:7.0
OLLAMA_IMAGE=ollama/ollama:latest

# ---- Rede (padrao do lab) --------------------------------------------------
WAN_SUBNET=172.20.0.0/24
WAN_GW=172.20.0.1
FW_WAN_IP=172.20.0.2
LAN_SUBNET=192.168.10.0/24
LAN_DOCKER_GW=192.168.10.254
FW_LAN_IP=192.168.10.1
SERVER_IP=192.168.10.10
CLIENTE_IP=192.168.10.20
MGMT_SUBNET=172.30.0.0/24
MGMT_GW=172.30.0.1
FW_MGMT_IP=172.30.0.2
WAZUH_MANAGER_IP=172.30.0.10
WAZUH_INDEXER_IP=172.30.0.11
WAZUH_DASHBOARD_IP=172.30.0.12
OLLAMA_IP=172.30.0.20
AI_ANALYST_IP=172.30.0.21

# ---- Acesso pelo navegador do host (somente localhost) ---------------------
WAZUH_DASHBOARD_PORT=8443

# ---- Credenciais do Wazuh ---------------------------------------------------
# Senhas padrao do wazuh-docker oficial. Para troca-las e preciso tambem
# atualizar os hashes em wazuh/config/wazuh_indexer/internal_users.yml
# (ver wazuh/README.md). Use apenas em laboratorio isolado.
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-

# ---- Usuario SSH do Ubuntu Server (alvo dos testes do lab) -----------------
LAB_SSH_USER=labuser
LAB_SSH_PASSWORD=troque-esta-senha

# ---- Firewall --------------------------------------------------------------
# Token da API de bloqueio do firewall (usada pelo ai-analyst). Troque!
FW_API_TOKEN=troque-este-token
# Tempo padrao de bloqueio aplicado pela API
FW_BLOCK_TIMEOUT=1h

# ---- IA (Ollama) -----------------------------------------------------------
# deepseek-r1:8b (padrao) | hermes3:8b | versoes menores: deepseek-r1:1.5b, hermes3:3b
LLM_MODEL=deepseek-r1:8b
EMBED_MODEL=nomic-embed-text
# Use http://ollama:11434 (container) ou http://host.docker.internal:11434
# se o Ollama estiver instalado direto no Windows
OLLAMA_URL=http://ollama:11434
# Nivel minimo de alerta para analise individual
AI_MIN_LEVEL=7
# Alertas de nivel menor da mesma origem agrupados a partir desta quantidade
AI_GROUP_THRESHOLD=10
AI_GROUP_WINDOW_S=300
AI_POLL_SECONDS=15
AI_HEALTH_INTERVAL_S=300
# Reincidencia: numero de incidentes anteriores da mesma origem/categoria
AI_RECURRENCE_THRESHOLD=1
# Prevencao automatica (bloqueio) - false = apenas recomenda em ia/recomendacoes.md
AUTO_BLOCK=false
# true = aplica automaticamente somente quando houver reincidencia (recomendado)
AUTO_BLOCK_REQUIRE_RECURRENCE=true
# Redes onde o bloqueio automatico e permitido (somente IPs do lab)
AUTO_BLOCK_NETWORKS=192.168.10.0/24
# IPs que nunca serao bloqueados
AUTO_BLOCK_PROTECTED=192.168.10.1,192.168.10.254,172.30.0.10,172.30.0.21

# ---- Limites de memoria (ajuste conforme a RAM do host) --------------------
INDEXER_JAVA_OPTS=-Xms1g -Xmx1g
OLLAMA_MEM_LIMIT=8g
